---
// The list of news posts in one language, inside Starlight's page frame.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { dateFormat, page, strings, type Lang } from '../landing';
import { feedLink, getPosts } from '../news';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang].newsPage;
const posts = await getPosts(lang);
---

<StarlightPage frontmatter={{ title: t.title, description: t.description, tableOfContents: false, pagefind: false, head: feedLink(lang) }}>
	{posts.length === 0 && <p>{t.empty}</p>}
	<ul class="posts not-content">
		{
			posts.map((p) => (
				<li>
					<time datetime={p.data.date.toISOString().slice(0, 10)}>{dateFormat(lang, p.data.date)}</time>
					<h2>
						<a href={page(lang, `news/${p.slug}/`)}>{p.data.title}</a>
					</h2>
					<p>{p.data.description}</p>
				</li>
			))
		}
	</ul>
	<p><a href={page(lang, 'news/rss.xml')}>{t.feed}</a></p>
</StarlightPage>

<style>
	.posts {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
	}
	.posts li {
		padding-block: 1.25rem 1.5rem;
		border-top: 1px solid var(--ct-hairline-strong);
	}
	.posts li + li {
		margin-top: 0;
	}
	time {
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		color: var(--ct-muted);
	}
	h2 {
		margin: 0.375rem 0 0.5rem;
		font-family: var(--ct-font-display);
		font-size: 1.375rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}
	h2 a {
		color: var(--ct-ink);
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--ct-accent-text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.posts p {
		margin: 0;
		color: var(--ct-text);
	}
</style>
