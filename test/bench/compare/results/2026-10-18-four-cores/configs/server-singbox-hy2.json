{
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "listen_port": 443,
      "tag": "in",
      "tls": {
        "alpn": [
          "h3"
        ],
        "certificate_path": "/cfg/cert.pem",
        "enabled": true,
        "key_path": "/cfg/key.pem"
      },
      "type": "hysteria2",
      "users": [
        {
          "name": "u",
          "password": "<redacted>"
        }
      ]
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "final": "direct"
  }
}
