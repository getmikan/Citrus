-s dir
--name citrus
--category net
--license GPL-3.0-or-later
--description "Citrus network core for Mikan."
--url "https://github.com/getmikan/Citrus"
--maintainer "Mikan"
--deb-field "Bug: https://github.com/getmikan/Citrus/issues"
--no-deb-generate-changes
--config-files /etc/citrus/config.yaml

.github/release/config.yaml=/etc/citrus/config.yaml

.github/release/mihomo.service=/usr/lib/systemd/system/citrus.service
.github/release/mihomo@.service=/usr/lib/systemd/system/citrus@.service
.github/release/citrus-server.service=/usr/lib/systemd/system/citrus-server.service
.github/release/citrus-server.sysusers=/usr/lib/sysusers.d/citrus-server.conf
docker/server-config.yaml=/usr/share/citrus/server-config.yaml


LICENSE=/usr/share/licenses/citrus/LICENSE
