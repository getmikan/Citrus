# Optional server image, built from the same bin/ release artifacts as Dockerfile.
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS builder
ARG TARGETPLATFORM
RUN apk add --no-cache gzip
WORKDIR /build
COPY docker/file-name.sh ./file-name.sh
COPY bin/ ./bin/
RUN FILE_NAME="$(sh file-name.sh).gz" && \
    gzip -dc "bin/$FILE_NAME" > citrus && chmod 0755 citrus

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
LABEL org.opencontainers.image.source="https://github.com/getmikan/Citrus"
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S -g 65532 citrus && \
    adduser -S -D -H -u 65532 -G citrus -h /var/lib/citrus -s /sbin/nologin citrus && \
    mkdir -p /var/lib/citrus /etc/citrus && \
    chown citrus:citrus /var/lib/citrus && chmod 0700 /var/lib/citrus
COPY --from=builder /build/citrus /citrus
COPY docker/server-config.yaml /etc/citrus/config.yaml
ENV HOME=/var/lib/citrus SAFE_PATHS=/etc/citrus
WORKDIR /var/lib/citrus
VOLUME ["/var/lib/citrus"]
USER 65532:65532
ENTRYPOINT ["/citrus", "-d", "/var/lib/citrus", "-f", "/etc/citrus/config.yaml"]
